<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- 1. namespace를 AccessLogMapper 인터페이스 경로와 정확히 일치시킵니다. -->
<mapper namespace="com.ntropy.user.mapper.AccessLogMapper">

    <!-- 2. id를 인터페이스의 메서드명과 정확히 일치시킵니다. -->
    <insert id="insertAccessLog" parameterType="com.ntropy.user.model.AccessLog">

        /*
           아래 쿼리는 예시입니다.
           실제 DB의 access_log 테이블 컬럼과 AccessLog 객체의 필드명에 맞게 수정해 주세요.
        */
        INSERT INTO access_log (
            user_id,
            ip_address,
            user_agent,
            access_time
        ) VALUES (
                     #{userId},
                     #{ipAddress},
                     #{userAgent},
                     NOW()
                 )

    </insert>

</mapper>
