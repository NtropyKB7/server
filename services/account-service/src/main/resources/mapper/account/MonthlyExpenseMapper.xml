<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ntropy.account.mapper.MonthlyExpenseMapper">

    <!--
        이슈 #143/#148/#169: 일간 분류 대상인 LOAN(out_amount > 0)·
        INSTALLMENT(in_amount > 0)는 매일 02:00 배치(#148,
        ai-service TransactionPreClassificationService)가 정상 처리하면 TXN_ANALYSIS 행이 생긴다
        (LOAN 정상상환/INSTALLMENT는 TRUE/FINANCE/FIXED, LOAN 지급은 FALSE/NULL/NULL).
        하지만 이 월간 집계 쿼리는 그 값을 참조하지 않고 ACCOUNT_TRANSACTION에서
        직접 재계산한다. 이유는 "TXN_ANALYSIS 행이 없어서"가 아니라 다음 정책 때문이다.

          1. 배치 실행 여부·성공 여부와 무관하게 진단 조회·확정에서도 즉시 결정적으로
             계산할 수 있어야 한다(배치 전/실패 시에도 값이 새거나 누락되면 안 된다).
          2. LOAN 원금은 소비에서 제외하고 loan_interest_amount만 반영해야 하는데,
             이 원금/이자 분리는 TXN_ANALYSIS에 없는 정보라 어차피 원본 컬럼이 필요하다.
          3. INSTALLMENT는 적립액이 in_amount에 들어오므로 일반 out_amount 합산 규칙을
             그대로 쓰면 항상 0원으로 집계된다(#169에서 발견, INSTALLMENT 전용 분기 추가).

        LOAN 신규·실행·증액(대출금 지급) 판정 키워드는 common 모듈의
        LoanDisbursementKeywords와 단일 소스를 공유하며, 호출 측이
        loanDisbursementKeywords 파라미터로 전달한다(FinancialCommitmentMapper의
        상환 후보 판정과도 동일 목록을 쓴다).

        loan_interest_amount가 NULL이거나 음수이면 0으로 취급해 총상환액이 그대로
        새어 들어가거나 음수가 총소비를 깎는 것을 막는다. out_amount와
        loan_principal_amount+loan_interest_amount 합이 실제로 일치하는지는 보지
        않는다(원천 신뢰, 불일치는 이 쿼리의 관심사가 아니다).
    -->
    <sql id="loanAwareAmount">
        CASE
            WHEN transaction_row.transaction_category = 'LOAN'
                THEN GREATEST(COALESCE(transaction_row.loan_interest_amount, 0), 0)
            WHEN transaction_row.transaction_category = 'INSTALLMENT'
                THEN GREATEST(COALESCE(transaction_row.in_amount, 0), 0)
            ELSE transaction_row.out_amount
        END
    </sql>

    <!--
        카테고리별 집계 전용: LOAN 이자·INSTALLMENT 적립액은 TXN_ANALYSIS.category와
        무관하게 항상 'FINANCE'로 고정한다(#169 요약표 참고).
    -->
    <sql id="loanAwareCategory">
        CASE
            WHEN transaction_row.transaction_category IN ('LOAN', 'INSTALLMENT') THEN 'FINANCE'
            ELSE analysis_row.category
        END
    </sql>

    <!--
        LOAN 신규·실행·증액(대출금 지급) 거래를 제외한다. 판정 의미는
        "공백 정규화 후 부분 문자열 포함"이며, LoanDisbursementKeywords와 동일하다.
        loan_transaction_type_name이 NULL이면 COALESCE로 빈 문자열이 되어 어떤
        키워드와도 매치되지 않으므로 별도 NULL 분기 없이 상환 후보로 인정된다.
    -->
    <sql id="loanDisbursementExclusion">
        <foreach collection="loanDisbursementKeywords" item="keyword" separator=" AND ">
            REGEXP_REPLACE(
                COALESCE(transaction_row.loan_transaction_type_name, ''),
                '[[:space:]]+',
                ''
            ) NOT LIKE CONCAT('%', #{keyword}, '%')
        </foreach>
    </sql>

    <!-- LOAN 소비 집계 대상은 양수 이자가 있는 정상 상환(비지급) 거래로 한정한다. -->
    <sql id="loanInterestConsumptionFilter">
        transaction_row.transaction_category = 'LOAN'
        AND transaction_row.out_amount &gt; 0
        AND transaction_row.loan_interest_amount &gt; 0
        AND (<include refid="loanDisbursementExclusion"/>)
    </sql>

    <!-- INSTALLMENT 소비 집계 대상은 양수 적립액이 들어온 거래로 한정한다. -->
    <sql id="installmentConsumptionFilter">
        transaction_row.transaction_category = 'INSTALLMENT'
        AND transaction_row.in_amount &gt; 0
    </sql>

    <!--
        총소비·카테고리별 소비 포함 대상: LOAN·INSTALLMENT는 TXN_ANALYSIS 유무와 무관하게
        각자의 결정적 필터를 만족하는 거래만 포함한다. 그 외 거래는 기존과 동일하게
        is_consumption = TRUE인 것만 포함하되, LOAN·INSTALLMENT가 분류 행을 통해
        중복·우회 집계되지 않도록 거래 유형을 명시적으로 분리한다.
    -->
    <sql id="consumptionFilter">
        (
            (<include refid="loanInterestConsumptionFilter"/>)
            OR (<include refid="installmentConsumptionFilter"/>)
            OR (
                transaction_row.transaction_category NOT IN ('LOAN', 'INSTALLMENT')
                AND analysis_row.is_consumption = TRUE
            )
        )
    </sql>

    <!--
        고정지출 포함 대상: 정상 상환 LOAN 이자와 INSTALLMENT 적립액은 예정된 반복
        지출이므로 고정지출로도 집계한다. 그 외 거래는 기존과 동일하게
        is_consumption = TRUE AND expense_type = 'FIXED'만 포함한다.
    -->
    <sql id="fixedConsumptionFilter">
        (
            (<include refid="loanInterestConsumptionFilter"/>)
            OR (<include refid="installmentConsumptionFilter"/>)
            OR (
                transaction_row.transaction_category NOT IN ('LOAN', 'INSTALLMENT')
                AND analysis_row.is_consumption = TRUE
                AND analysis_row.expense_type = 'FIXED'
            )
        )
    </sql>

    <!--
        월별 총소비 금액을 조회합니다.

        집계 대상은 (1) is_consumption = TRUE인 일반 거래의 out_amount 전액, (2) LOAN
        거래의 loanAwareAmount(이자만, 원금 제외), (3) INSTALLMENT 거래의 in_amount입니다.
        거래는 발생 당시 기록을 기준으로 집계하며, 계좌가 이후 비활성화되더라도
        과거 거래는 계속 포함해야 하므로 account_row.status 필터는 쓰지 않는다.
    -->
    <select id="findTotalExpense"
            resultType="java.lang.Long">

        SELECT COALESCE(SUM(<include refid="loanAwareAmount"/>), 0)
        FROM ACCOUNT account_row
        INNER JOIN ACCOUNT_TRANSACTION transaction_row
        ON transaction_row.account_id = account_row.account_id
        LEFT JOIN TXN_ANALYSIS analysis_row
        ON analysis_row.account_transaction_id =
        transaction_row.account_transaction_id
        WHERE account_row.user_id = #{userId}
        AND transaction_row.tran_date >= #{startDate}
        AND transaction_row.tran_date &lt; #{endDate}
        AND <include refid="consumptionFilter"/>

    </select>

    <!--
        월별 카테고리 소비 금액을 조회합니다. status 필터를 쓰지 않는 이유와 LOAN·INSTALLMENT
        처리 방식은 findTotalExpense와 동일합니다. LOAN 이자·INSTALLMENT 적립액은
        category = 'FINANCE'로 고정됩니다.
    -->
    <select id="findCategoryExpenses"
            resultType="com.ntropy.common.dto.account.CategoryExpenseAmount">

        SELECT
        <include refid="loanAwareCategory"/> AS category,
        COALESCE(SUM(<include refid="loanAwareAmount"/>), 0)
        AS expenseAmount
        FROM ACCOUNT account_row
        INNER JOIN ACCOUNT_TRANSACTION transaction_row
        ON transaction_row.account_id = account_row.account_id
        LEFT JOIN TXN_ANALYSIS analysis_row
        ON analysis_row.account_transaction_id =
        transaction_row.account_transaction_id
        WHERE account_row.user_id = #{userId}
        AND transaction_row.tran_date >= #{startDate}
        AND transaction_row.tran_date &lt; #{endDate}
        AND <include refid="consumptionFilter"/>
        GROUP BY <include refid="loanAwareCategory"/>
        ORDER BY category

    </select>

    <!--
        월별 고정지출 합계를 조회합니다. status 필터를 쓰지 않는 이유는 findTotalExpense와
        동일하고, LOAN 이자·INSTALLMENT 적립액을 고정지출에 포함하는 이유는
        fixedConsumptionFilter를 참고한다.
    -->
    <select id="findFixedExpense"
            resultType="java.lang.Long">

        SELECT COALESCE(SUM(<include refid="loanAwareAmount"/>), 0)
        FROM ACCOUNT account_row
        INNER JOIN ACCOUNT_TRANSACTION transaction_row
        ON transaction_row.account_id = account_row.account_id
        LEFT JOIN TXN_ANALYSIS analysis_row
        ON analysis_row.account_transaction_id =
        transaction_row.account_transaction_id
        WHERE account_row.user_id = #{userId}
        AND transaction_row.tran_date >= #{startDate}
        AND transaction_row.tran_date &lt; #{endDate}
        AND <include refid="fixedConsumptionFilter"/>

    </select>

</mapper>
