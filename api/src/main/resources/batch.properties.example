# 이 파일을 ${NTROPY_CONFIG_DIR}/batch.properties로 복사해 사용하세요.
# 컨테이너 기본 경로는 /usr/local/tomcat/conf/ntropy/batch.properties입니다.
# 허용값: REAL_ONLY, VIRTUAL_ONLY, ALL
batch.financial-sync.user-scope=REAL_ONLY
batch.settlement.user-scope=REAL_ONLY
batch.work-reminder.user-scope=REAL_ONLY
batch.ai-report.user-scope=REAL_ONLY
